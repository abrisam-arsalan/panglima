# dependensi & build — TIDAK di-commit di branch main
node_modules/
.next/
out/

# client read-only CBT: hasil `prisma generate` — DI-COMMIT (dipakai skrip
# bootstrap saat runtime di server, dan Next standalone tidak men-trace-nya)
!src/generated/
src/generated/**/.gitignore

# rahasia & data lokal
.env
.env.local
storage/
*.db
*.db-*

# data PII sekolah — JANGAN PERNAH masuk repo publik
# (nama guru/siswa asli, NISN/NIP, roster, jadwal riil)
referensi/
*_nilai_*.xlsx
contoh-*.xlsx
scripts/seed_full_schedule.js
scripts/inspect_db.js
prisma/seed-demo.ts
prisma/simulate-workflow.ts

# temp
*.log
.DS_Store
Thumbs.db

# NOTE: branch `deploy` sengaja meng-commit artefak build (scripts/deploy.sh
# memakai `git add -f`). Aturan sekolah: push ke GitHub → server tinggal pull.

# artifacts lokal
tsconfig.tsbuildinfo
