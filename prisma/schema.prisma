// ══════════════════════════════════════════════════════════════════════════
// FASE P1 — DRAF skema `panglima` (satu-satunya pemilik DDL: PRISMA)
// Kode: panglima.prisma · 2026-10-17
// Keputusan nama/kolom: lihat P1-SKEMA-PANGLIMA.md
//
// Aturan yang mengikat (PRD-PANGLIMA-PORTAL-v2.md §3):
//   A1  schema `panglima` hanya dimigrasi Prisma — Laravel DILARANG menulis DDL
//   A3  cbt_tka.users = VIEW ke tabel `users` di bawah (satu tabel → boleh UPDATE)
//   A5  setiap perubahan bentuk view dicatat sebagai migrasi Prisma
//
// provider mysql dipakai untuk MariaDB 11.8 (sama seperti lms/prisma/schema.prisma).
// Database dibuat eksplisit: CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
// ══════════════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── ENUM ───────────────────────────────────────────────────────────────────
// Nilai disimpan HURUF KECIL di DB (keputusan F-3) supaya VIEW cbt_tka.users
// tidak perlu transform apa pun (jebakan V4 / STATUS §8.3).
// Di Prisma/TS nama variant tetap ADMIN/GURU/SISWA/ORTU/KEPSEK — @map hanya
// mengubah label yang tersimpan di kolom ENUM MariaDB.

enum Role {
  ADMIN  @map("admin")
  GURU   @map("guru")
  SISWA  @map("siswa")
  ORTU   @map("ortu")
  KEPSEK @map("kepsek")
}

enum PublishStatus {
  DRAF   @map("draf")
  TERBIT @map("terbit")
}

enum SubmitType {
  FILE    @map("file")
  TEKS    @map("teks")
  CENTANG @map("centang")
}

enum SubmissionStatus {
  ONTIME @map("ontime")
  LATE   @map("late")
}

enum GradeTarget {
  TUGAS  @map("tugas")
  MANUAL @map("manual")
}

enum TpScoreSource {
  AUTO   @map("auto")
  MANUAL @map("manual")
}

enum TpFlagType {
  PERLU_PENINGKATAN @map("perlu_peningkatan")
  SANGAT_TERCAPAI   @map("sangat_tercapai")
}

enum AnnouncementScope {
  SEMUA @map("semua")
  KELAS @map("kelas")
}

/// Sesi mengajar (dulu `sesi_mengajar.status` = dibuka|selesai)
enum ClassSessionStatus {
  DIBUKA  @map("dibuka")
  SELESAI @map("selesai")
}

/// Dulu `kehadiran.status` = hadir|sakit|izin|alpha (label UI "Alpa")
enum AttendanceStatus {
  HADIR @map("hadir")
  SAKIT @map("sakit")
  IZIN  @map("izin")
  ALPHA @map("alpha")
}

/// Dulu `orang_tua.hubungan` = Ayah|Ibu|Wali — dulu TANPA CHECK di DB
enum ParentRelation {
  AYAH @map("ayah")
  IBU  @map("ibu")
  WALI @map("wali")
}

// ── INTI IDENTITAS ─────────────────────────────────────────────────────────

/// SATU-SATUNYA tabel akun. `students`/`teachers` (LMS), `siswa`/`guru`/
/// `orang_tua` (presensi), `mpi_users` (MPI) DILEBUR ke sini — keputusan F-1.
/// Kolom `pin_cipher`, `remember_token`, `last_login_ip`, `email_verified_at`,
/// `class_id` ada di tabel ini justru agar VIEW cbt_tka.users tetap satu tabel
/// dan bisa di-UPDATE oleh Laravel (jebakan #1 / risiko V1).
model User {
  id              BigInt    @id @default(autoincrement())
  username        String    @unique @db.VarChar(64) // siswa=NISN · guru=NIP · ortu=P+NISN
  nama            String    @db.VarChar(120)
  email           String?   @unique @db.VarChar(191)
  phone           String?   @db.VarChar(32)
  nis             String?   @unique @db.VarChar(32)
  nisn            String?   @unique @db.VarChar(32)
  nip             String?   @unique @db.VarChar(32) // guru
  kode            String?   @unique @db.VarChar(16) // kode guru — kunci template jadwal presensi
  passwordHash    String    @map("password_hash") @db.VarChar(255) // bcrypt, cocok password_verify()
  pinCipher       String?   @map("pin_cipher") @db.Text
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  role            Role
  isActive        Boolean   @default(true) @map("is_active")
  mustChangePin   Boolean   @default(false) @map("must_change_pin") // v1.4 §6.2.4 kendali #6
  classId         BigInt?   @map("class_id") // rombel SAAT INI — satu-satunya tempat fakta ini (F-2)
  lastLoginAt     DateTime? @map("last_login_at")
  lastLoginIp     String?   @map("last_login_ip") @db.VarChar(45)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at") // soft delete: riwayat nilai/attempt tetap utuh

  classRef          Class?           @relation("ClassMembers", fields: [classId], references: [id], onDelete: SetNull)
  homeroomOf        Class[]          @relation("Homeroom")
  assignments       Assignment[]
  classSessions     ClassSession[]
  createdMaterials  Material[]       @relation("MaterialAuthor")
  createdTasks      Task[]           @relation("TaskAuthor")
  submissions       Submission[]     @relation("Submissions")
  gradesGiven       Grade[]          @relation("GradesGiven")
  gradesReceived    Grade[]          @relation("GradesReceived")
  tpScores          TpScore[]        @relation("TpScores")
  tpFlags           TpFlag[]         @relation("TpFlags")
  reportScores      ReportScore[]    @relation("ReportScores")
  attendance        AttendanceRecord[]
  parentLinksAsOrtu ParentLink[]     @relation("ParentSide")
  parentLinksAsAnak ParentLink[]     @relation("ChildSide")
  sessions          Session[]
  notifications     Notification[]
  announcements     Announcement[]
  auditLogs         AuditLog[]
  materialReads     MaterialRead[]
  loginAttempts     LoginAttempt[]
  handoffCodes      HandoffCode[]
  mpiGames          MpiGame[]        @relation("MpiGameOwner")
  mpiQuestions      MpiQuestion[]    @relation("MpiQuestionOwner")

  @@index([role, isActive])
  @@index([classId, role])
  @@map("users")
}

/// Rombel. Dulu `kelas` (presensi) + `classes` (LMS) + `classes` (CBT) → satu.
/// `wali_kelas` yang di presensi hanya TEKS nama guru kini jadi FK, sehingga
/// aturan "wali kelas = rekap baca-saja" akhirnya bisa ditegakkan di DB.
model Class {
  id             BigInt   @id @default(autoincrement())
  name           String   @db.VarChar(16) // "8A"
  tingkat        Int      @db.TinyInt // 7/8/9 — beda konsep dgn mpi_questions.tingkat
  academicYearId BigInt   @map("academic_year_id")
  homeroomUserId BigInt?  @map("homeroom_user_id")
  isActive       Boolean  @default(true) @map("is_active")
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  homeroom      User?          @relation("Homeroom", fields: [homeroomUserId], references: [id], onDelete: SetNull)
  members       User[]         @relation("ClassMembers")
  assignments   Assignment[]
  announcements Announcement[]

  @@unique([name, academicYearId])
  @@index([academicYearId, isActive])
  @@map("classes")
}

// ── WAKTU AKADEMIK (acuan tunggal, dari LMS) ───────────────────────────────

model AcademicYear {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(16) // "2026/2027"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  semesters Semester[]
  classes   Class[]

  @@map("academic_years")
}

model Semester {
  id       BigInt  @id @default(autoincrement())
  yearId   BigInt  @map("year_id")
  number   Int     @db.TinyInt
  name     String  @db.VarChar(8)
  isActive Boolean @default(false) @map("is_active")

  year        AcademicYear @relation(fields: [yearId], references: [id], onDelete: Restrict)
  assignments Assignment[]

  @@unique([yearId, number])
  @@map("semesters")
}

// ── MAPEL & PENUGASAN ──────────────────────────────────────────────────────

/// Mata pelajaran (dulu `mata_pelajaran` presensi + `subjects` LMS).
/// `mpi_mapel` TIDAK dilebur ke sini — lihat catatan MpiSubject.
model Subject {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  code      String   @db.VarChar(16) // MTK/BIN/BIG
  createdAt DateTime @default(now()) @map("created_at")

  assignments Assignment[]

  @@map("subjects")
}

/// guru × mapel × rombel × semester = SPINE modul akademik & presensi.
/// Ini jawaban atas tabrakan `jadwal`(presensi) vs `schedules`(LMS): keduanya
/// adalah proyeksi dari penugasan, jadi jadwal turunan dibuat di bawah sini.
model Assignment {
  id         BigInt  @id @default(autoincrement())
  teacherId  BigInt  @map("teacher_id")
  subjectId  BigInt  @map("subject_id")
  classId    BigInt  @map("class_id")
  semesterId BigInt  @map("semester_id")
  createdAt  DateTime @default(now()) @map("created_at")

  teacher           User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  semester          Semester           @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  learningTargets   LearningTarget[]
  materials         Material[]
  tasks             Task[]
  schedules         Schedule[]
  manualAssessments ManualAssessment[]
  reportScores      ReportScore[]

  @@unique([teacherId, subjectId, classId, semesterId])
  @@index([classId, semesterId])
  @@map("assignments")
}

// ── JADWAL MINGGUAN (satu tabel; kata `jadwal` hilang — keputusan F-4) ──────

/// Baris tetap jadwal mingguan. ON DELETE = RESTRICT di seluruh rantai:
/// `DELETE FROM schedules` tidak lagi bisa menghapus riwayat absensi (jebakan #4),
/// dan `@@unique` menutup celah slot ganda yang di LMS tidak ada constraint-nya.
model Schedule {
  id           BigInt   @id @default(autoincrement())
  assignmentId BigInt   @map("assignment_id")
  day          Int      @db.TinyInt // 0=Minggu..6=Sabtu (cocok getDay() & hariValid() presensi)
  startTime    String   @map("start_time") @db.VarChar(5) // "07:30"
  endTime      String   @map("end_time") @db.VarChar(5)
  room         String?  @db.VarChar(60)
  // V-P1-3: pengganti tombol "replace" template — nonaktifkan, jangan hapus.
  // Jadwal nonaktif hilang dari presensi/jadwal tapi sesi lama tetap terbaca.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment    Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  classSessions ClassSession[]

  @@unique([assignmentId, day, startTime])
  @@index([day])
  @@map("schedules")
}

// ── PRESENSI (dulu `sesi_mengajar` + `kehadiran`) ───────────────────────────

/// Satu sesi mengajar nyata: jadwal × tanggal.
/// RESTRICT pada kedua sisi → riwayat kehadiran hanya hilang lewat prosedur
/// eksplisit, bukan efek samping CASCADE.
model ClassSession {
  id           BigInt             @id @default(autoincrement())
  scheduleId   BigInt             @map("schedule_id")
  teacherId    BigInt             @map("teacher_id")
  date         DateTime           @db.Date
  // TANPA @default(""): MySQL 8.4 menolak DEFAULT pada TEXT (err 1101),
  // MariaDB 11.8 membolehkan — skema harus jalan di keduanya. Kode selalu
  // menulis string eksplisit saat create (openSession) & update (saveAttendance).
  materi       String             @db.Text
  catatanKelas String             @map("catatan_kelas") @db.Text
  status       ClassSessionStatus @default(DIBUKA)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at")

  schedule Schedule           @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  teacher  User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  records  AttendanceRecord[]

  @@unique([scheduleId, date]) // kunci idempoten yang sudah dipakai presensi
  @@index([teacherId, date])
  @@index([status])
  @@map("class_sessions")
}

model AttendanceRecord {
  id         BigInt           @id @default(autoincrement())
  sessionId  BigInt           @map("session_id")
  studentId  BigInt           @map("student_id") // users.id
  status     AttendanceStatus @default(HADIR)
  keterangan String           @default("") @db.VarChar(255)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student User         @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@map("attendance_records")
}

/// Ortu ↔ anak. Dulu `orang_tua` (presensi) + `parent_students` (LMS).
/// `@@unique([parent_id])` menegakkan keputusan Q9 "1 akun ortu = 1 anak" di DB.
/// Anak boleh punya lebih dari satu ortu → TIDAK ada unique pada child_id.
model ParentLink {
  parentId  BigInt         @map("parent_id")
  childId   BigInt         @map("child_id")
  hubungan  ParentRelation @default(WALI)
  createdAt DateTime       @default(now()) @map("created_at")

  parent User @relation("ParentSide", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildSide", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@unique([parentId])
  @@index([childId])
  @@map("parent_links")
}

// ── LMS: TP / MATERI / TUGAS / NILAI (bentuk lama dipertahankan) ────────────

model LearningTarget {
  id           BigInt   @id @default(autoincrement())
  assignmentId BigInt   @map("assignment_id")
  code         String   @db.VarChar(32) // "TP1"
  content      String   @db.Text
  urutan       Int
  createdAt    DateTime @default(now()) @map("created_at")

  assignment      Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  tpScores        TpScore[]
  tpFlags         TpFlag[]
  materials       Material[]
  tasks           Task[]
  manualAssessments ManualAssessment[]

  @@unique([assignmentId, code])
  @@map("learning_targets")
}

model Material {
  id           BigInt        @id @default(autoincrement())
  assignmentId BigInt        @map("assignment_id")
  tpId         BigInt?       @map("tp_id")
  judul        String        @db.VarChar(200)
  body         String        @db.LongText
  status       PublishStatus @default(DRAF)
  publishAt    DateTime?     @map("publish_at")
  urutan       Int           @default(0)
  createdById  BigInt        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  assignment Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  tp         LearningTarget? @relation(fields: [tpId], references: [id], onDelete: SetNull)
  createdBy  User            @relation("MaterialAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  files      MaterialFile[]
  reads      MaterialRead[]

  @@index([assignmentId, status, urutan])
  @@map("materials")
}

model MaterialFile {
  id         BigInt   @id @default(autoincrement())
  materialId BigInt   @map("material_id")
  nama       String   @db.VarChar(255)
  storedName String   @unique @map("stored_name") @db.VarChar(128)
  mime       String   @db.VarChar(120)
  sizeBytes  BigInt   @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_files")
}

model MaterialRead {
  materialId BigInt   @map("material_id")
  userId     BigInt   @map("user_id")
  readAt     DateTime @default(now()) @map("read_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([materialId, userId])
  @@map("material_reads")
}

model Task {
  id           BigInt        @id @default(autoincrement())
  assignmentId BigInt        @map("assignment_id")
  tpId         BigInt?       @map("tp_id")
  judul        String        @db.VarChar(200)
  instruksi    String        @db.LongText
  tipe         SubmitType    @default(FILE)
  dueAt        DateTime      @map("due_at")
  lateUntil    DateTime?     @map("late_until")
  maxFileMb    Int           @default(20) @map("max_file_mb")
  status       PublishStatus @default(DRAF)
  publishAt    DateTime?     @map("publish_at")
  createdById  BigInt        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  assignment  Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  tp          LearningTarget? @relation(fields: [tpId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  files       TaskFile[]
  submissions Submission[]

  @@index([assignmentId, status, dueAt])
  @@map("tasks")
}

model TaskFile {
  id         BigInt   @id @default(autoincrement())
  taskId     BigInt   @map("task_id")
  nama       String   @db.VarChar(255)
  storedName String   @unique @map("stored_name") @db.VarChar(128)
  mime       String   @db.VarChar(120)
  sizeBytes  BigInt   @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_files")
}

model Submission {
  id          BigInt           @id @default(autoincrement())
  taskId      BigInt           @map("task_id")
  studentId   BigInt           @map("student_id")
  text        String?          @db.Text
  status      SubmissionStatus @default(ONTIME)
  revisiCount Int              @default(0) @map("revisi_count")
  submittedAt DateTime         @default(now()) @map("submitted_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student     User             @relation("Submissions", fields: [studentId], references: [id], onDelete: Restrict)
  files       SubmissionFile[]
  grades      Grade[]

  @@unique([taskId, studentId])
  @@map("submissions")
}

model SubmissionFile {
  id           BigInt   @id @default(autoincrement())
  submissionId BigInt   @map("submission_id")
  nama         String   @db.VarChar(255)
  storedName   String   @unique @map("stored_name") @db.VarChar(128)
  mime         String   @db.VarChar(120)
  sizeBytes    BigInt   @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_files")
}

/// Penilaian tanpa berkas unggahan (praktik/sikap/lisan).
model ManualAssessment {
  id           BigInt   @id @default(autoincrement())
  assignmentId BigInt   @map("assignment_id")
  tpId         BigInt?  @map("tp_id")
  nama         String   @db.VarChar(80)
  keterangan   String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  tp         LearningTarget? @relation(fields: [tpId], references: [id], onDelete: SetNull)
  grades     Grade[]

  @@unique([assignmentId, nama]) // idempoten impor PTS per label ("PTS Ganjil 26/27")
  @@map("manual_assessments")
}

model Grade {
  id                 BigInt      @id @default(autoincrement())
  target             GradeTarget
  submissionId       BigInt?     @unique @map("submission_id")
  manualAssessmentId BigInt?     @map("manual_assessment_id")
  studentId          BigInt      @map("student_id")
  score              Decimal     @db.Decimal(5, 2)
  feedback           String?     @db.Text
  gradedById         BigInt      @map("graded_by")
  gradedAt           DateTime    @default(now()) @map("graded_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  submission       Submission?       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  manualAssessment ManualAssessment? @relation(fields: [manualAssessmentId], references: [id], onDelete: Cascade)
  student          User              @relation("GradesReceived", fields: [studentId], references: [id], onDelete: Restrict)
  gradedBy         User              @relation("GradesGiven", fields: [gradedById], references: [id], onDelete: Restrict)

  @@index([manualAssessmentId, studentId])
  @@unique([manualAssessmentId, studentId]) // satu nilai per siswa per asesmen (impor ulang = update)
  @@map("grades")
}

/// Nilai ketercapaian TP per siswa. `student_id` SELALU users.id (keputusan F-1
/// menghapus ambiguitas LMS lama yang mencampur users.id dan students.id).
model TpScore {
  id        BigInt        @id @default(autoincrement())
  tpId      BigInt        @map("tp_id")
  studentId BigInt        @map("student_id")
  score     Decimal       @db.Decimal(5, 2)
  source    TpScoreSource @default(AUTO)
  updatedAt DateTime      @updatedAt @map("updated_at")

  tp      LearningTarget @relation(fields: [tpId], references: [id], onDelete: Cascade)
  student User           @relation("TpScores", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([tpId, studentId])
  @@index([studentId])
  @@map("tp_scores")
}

model TpFlag {
  id        BigInt     @id @default(autoincrement())
  tpId      BigInt     @map("tp_id")
  studentId BigInt     @map("student_id")
  type      TpFlagType

  tp      LearningTarget @relation(fields: [tpId], references: [id], onDelete: Cascade)
  student User           @relation("TpFlags", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([tpId, studentId, type])
  @@map("tp_flags")
}

/// Nilai rapor = turunan tp_scores per assignment (src/lib/gradebook.ts).
/// isManual=true (via setReportScore) TIDAK ditimpa recomputeReports —
/// koreksi guru adalah keputusan, bukan hitungan yang boleh dihitung ulang.
model ReportScore {
  id           BigInt   @id @default(autoincrement())
  assignmentId BigInt   @map("assignment_id")
  studentId    BigInt   @map("student_id")
  score        Decimal  @db.Decimal(5, 2)
  isManual     Boolean  @default(false) @map("is_manual")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("ReportScores", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@map("report_scores")
}

// ── PENGUMUMAN & NOTIFIKASI ─────────────────────────────────────────────────

/// Dulu `pengumuman` (presensi) + `announcements` (LMS).
/// `author_nama`/`author_role` yang didenormalisasi di presensi DIHILANG —
/// dibaca dari JOIN ke `users`, supaya tidak ada salinan nama yang bisa basi.
model Announcement {
  id        BigInt            @id @default(autoincrement())
  judul     String            @db.VarChar(200)
  isi       String            @db.LongText
  target    AnnouncementScope @default(SEMUA)
  classId   BigInt?           @map("class_id")
  authorId  BigInt            @map("author_id")
  createdAt DateTime          @default(now()) @map("created_at")
  deletedAt DateTime?         @map("deleted_at")

  class  Class? @relation(fields: [classId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([target, classId])
  @@map("announcements")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  kind      String    @db.VarChar(40)
  message   String    @db.VarChar(255)
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ── SISTEM ──────────────────────────────────────────────────────────────────

/// Sesi login PORTAL. Nama `sessions` tetap: tabel `sessions` milik Laravel
/// hidup di schema `cbt_tka`, jadi tidak bertabrakan (keputusan F-6).
model Session {
  token     String   @id @db.VarChar(64)
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Rate limit login kini PERSISTEN. Di MPI lama ia hidup di `$_SESSION`
/// (login.php) dan di CBT di RateLimiter memory → hilang saat restart.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  username  String   @db.VarChar(64)
  userId    BigInt?  @map("user_id")
  success   Boolean
  ip        String   @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Kode sekali-pakai handoff portal → CBT (PRD v2 §6). Yang disimpan adalah
/// HASH-nya, bukan plaintext; `used_at` membuat kode tidak bisa dipakai dua kali.
model HandoffCode {
  id        BigInt    @id @default(autoincrement())
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  userId    BigInt    @map("user_id")
  target    String    @db.VarChar(32) // "cbt"
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("handoff_codes")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  detail    Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key   String @id @db.VarChar(64)
  value String @db.VarChar(500)

  @@map("settings")
}

// ── MPI (modul game) ────────────────────────────────────────────────────────

/// Dulu `mpi_games`. `file_path` menunjuk HTML di public/game/ (dipindah di P5).
model MpiGame {
  id        BigInt   @id @default(autoincrement())
  slug      String   @unique @db.VarChar(64)
  nama      String   @db.VarChar(160)
  deskripsi String?  @db.Text
  icon      String   @default("🎮") @db.VarChar(20)
  filePath  String   @default("") @map("file_path") @db.VarChar(255)
  tipe      String   @db.VarChar(40) // benar_salah / famili100 / gesture / ...
  ownerId   BigInt?  @map("owner_id")
  aktif     Boolean  @default(true)
  urutan    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  owner     User?         @relation("MpiGameOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  questions MpiQuestion[]

  @@index([aktif, urutan])
  @@map("mpi_games")
}

/// Dulu `mpi_mapel`. TIDAK dilebur ke `subjects`: isinya bukan penugasan guru,
/// melainkan pemilik bank soal MPI. Nama `mpi_subjects` dipakai supaya tidak
/// ada dua tabel bernama `subjects` (keputusan F-5).
model MpiSubject {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  questions MpiQuestion[]

  @@map("mpi_subjects")
}

/// Dulu `mpi_soal`. ⚠️ `answer_key` + `explanation` TIDAK BOLEH dikirim ke
/// klien (v1.4 §14.3): `api/questions.php` lama membocorkannya dan game HTML
/// memakai `s.kunci` untuk koreksi lokal. Di P5 koreksi pindah ke server.
model MpiQuestion {
  id           BigInt   @id @default(autoincrement())
  gameId       BigInt   @map("game_id")
  mpiSubjectId BigInt?  @map("mpi_subject_id")
  tingkat      Int?     @db.TinyInt // 7/8/9; NULL = semua (dulu `kelas VARCHAR(2)`)
  pertanyaan   String   @db.Text
  opsiA        String?  @default("Benar") @map("opsi_a") @db.VarChar(255)
  opsiB        String?  @default("Salah") @map("opsi_b") @db.VarChar(255)
  opsiC        String?  @map("opsi_c") @db.VarChar(255)
  opsiD        String?  @map("opsi_d") @db.VarChar(255)
  answerKey    String   @map("answer_key") @db.VarChar(8) // A/B/C/D (famili100 pakai payload)
  explanation  String?  @db.Text
  payload      Json?
  isDemo       Boolean  @default(false) @map("is_demo")
  ownerId      BigInt?  @map("owner_id")
  createdAt    DateTime @default(now()) @map("created_at")

  game       MpiGame      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  mpiSubject MpiSubject?  @relation(fields: [mpiSubjectId], references: [id], onDelete: SetNull)
  owner      User?        @relation("MpiQuestionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([gameId, isDemo])
  @@index([gameId, tingkat, mpiSubjectId])
  @@map("mpi_questions")
}
