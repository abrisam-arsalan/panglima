# ── Database ───────────────────────────────────────────────────────
DATABASE_URL="mysql://panglima_user:GANTI_PASSWORD@127.0.0.1:3306/panglima"

# ── Runtime ────────────────────────────────────────────────────────
PORT=3005
HOST=127.0.0.1
NODE_ENV=production

# ── Auth ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="GANTI_DENGAN_HEX_RAHASIA_64"

# ── API mesin-ke-mesin (CBT push skor) ────────────────────────────
API_TOKEN="GANTI_DENGAN_TOKEN_ACAK"

# ── Handoff ke CBT ────────────────────────────────────────────────
CBT_HANDOFF_SECRET="GANTI_DENGAN_SHARED_SECRET_CBT"
CBT_BASE_URL="https://ujian.smp5tegal.sch.id"
# 0 = tombol redirect login biasa (CBT lama, aman default).
# 1 = handoff kode sekali-pakai (butuh route /sso di CBT — P7).
CBT_SSO_ENABLED="0"
# Path repo Laravel CBT di server (untuk artisan cbt:sync-students).
# Kosongkan bila sync hanya via SQL fallback.
CBT_PATH="/var/www/ujian"

# ── Penyimpanan upload (di luar webroot nginx) ───────────────────────
STORAGE_DIR="/var/www/panglima/storage/uploads"

# ── Konfigurasi sekolah ───────────────────────────────────────────
SCHOOL_NAME="SMP Negeri 5 Tegal"
SCHOOL_ACADEMIC_YEAR="2026/2027"
SCHOOL_SEMESTER_NUMBER=1
